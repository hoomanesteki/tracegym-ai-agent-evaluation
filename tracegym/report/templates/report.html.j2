<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --bg: #f7f7f8; --panel: #ffffff; --ink: #1a1a1f; --muted: #6b6b76;
    --line: #e6e6ea; --accent: #4f46e5; --good: #16a34a; --bad: #dc2626;
    --warn: #d97706; --grey: #6b7280; --s1: #4f46e5;
    --shadow: 0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.05);
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#0e0e11; --panel:#17171c; --ink:#ececf1; --muted:#9a9aa6;
      --line:#26262e; --accent:#8b85ff; --s1:#6d66e8; --shadow:0 1px 2px rgba(0,0,0,.3),0 8px 24px rgba(0,0,0,.4); }
  }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;
    line-height:1.5; -webkit-font-smoothing:antialiased; }
  .wrap { max-width:960px; margin:0 auto; padding:48px 24px 80px; }
  header.hero { margin-bottom:36px; }
  .hero h1 { font-size:34px; letter-spacing:-.02em; margin:0 0 6px; }
  .hero p { color:var(--muted); margin:0; font-size:15px; }
  .grid { display:grid; gap:16px; }
  .kpis { grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); margin:28px 0 40px; }
  .tile { background:var(--panel); border:1px solid var(--line); border-radius:14px;
    padding:18px 20px; box-shadow:var(--shadow); }
  .tile .n { font-size:28px; font-weight:650; letter-spacing:-.02em; }
  .tile .l { color:var(--muted); font-size:12.5px; margin-top:2px; }
  section { margin:40px 0; }
  section h2 { font-size:13px; text-transform:uppercase; letter-spacing:.08em;
    color:var(--muted); margin:0 0 16px; font-weight:600; }
  .card { background:var(--panel); border:1px solid var(--line); border-radius:16px;
    padding:22px 24px; box-shadow:var(--shadow); }
  .card + .card { margin-top:16px; }
  .row { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .chip { display:inline-block; font-size:12px; font-weight:650; padding:3px 10px;
    border-radius:999px; }
  .chip.good,.chip.PASS,.chip.SAFE { background:color-mix(in srgb,var(--good) 15%,transparent); color:var(--good); }
  .chip.bad,.chip.BLOCK,.chip.REGRESSES { background:color-mix(in srgb,var(--bad) 15%,transparent); color:var(--bad); }
  .chip.INCONCLUSIVE,.chip.WARN { background:color-mix(in srgb,var(--warn) 15%,transparent); color:var(--warn); }
  .chip.ADVISORY_ONLY { background:color-mix(in srgb,var(--grey) 18%,transparent); color:var(--grey); }
  .sev { display:inline-block; font-size:11px; font-weight:650; text-transform:uppercase;
    letter-spacing:.03em; padding:2px 8px; border-radius:999px; }
  .sev.high { background:color-mix(in srgb,var(--bad) 15%,transparent); color:var(--bad); }
  .sev.med { background:color-mix(in srgb,var(--warn) 15%,transparent); color:var(--warn); }
  .sev.low { background:color-mix(in srgb,var(--grey) 18%,transparent); color:var(--grey); }
  table { width:100%; border-collapse:collapse; font-size:14px; }
  th,td { text-align:left; padding:9px 8px; border-bottom:1px solid var(--line); }
  th { color:var(--muted); font-weight:600; font-size:12px; text-transform:uppercase; letter-spacing:.04em; }
  td.num,th.num { text-align:right; font-variant-numeric:tabular-nums; }
  .bar { height:8px; border-radius:6px; background:color-mix(in srgb,var(--accent) 18%,transparent); overflow:hidden; }
  .bar > span { display:block; height:100%; background:var(--accent); border-radius:6px; }
  .metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(110px,1fr)); gap:14px; margin:6px 0 18px; }
  .metrics .m .v { font-size:20px; font-weight:600; }
  .metrics .m .k { color:var(--muted); font-size:12px; }
  .checklist { display:grid; gap:8px; margin-top:8px; }
  .checkrow { display:grid; grid-template-columns:180px 1fr 48px; gap:12px; align-items:center; font-size:13px; }
  .note { color:var(--muted); font-size:13px; margin-top:12px; }
  .mono { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12.5px; }
  code { background:color-mix(in srgb,var(--ink) 8%,transparent); padding:1px 6px; border-radius:6px; }
  footer { color:var(--muted); font-size:12.5px; margin-top:48px; border-top:1px solid var(--line); padding-top:18px; }
  .confusion { display:grid; grid-template-columns:auto auto auto; gap:1px; background:var(--line);
    border:1px solid var(--line); border-radius:10px; overflow:hidden; width:max-content; }
  .confusion div { background:var(--panel); padding:8px 16px; font-size:13px; text-align:center; }
  .confusion .hd { color:var(--muted); font-weight:600; }
  .gallery-item { border:1px solid var(--line); border-radius:14px; padding:16px 18px; margin-bottom:12px; background:var(--panel); }
  .diff { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:10px; }
  @media (max-width:640px){ .diff { grid-template-columns:1fr; } }
  .diff .col { border:1px solid var(--line); border-radius:10px; padding:10px 12px; }
  .diff .col.bad { border-color:color-mix(in srgb,var(--bad) 45%,var(--line)); }
  .diff h4 { margin:0 0 6px; font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); }
  .diff pre { margin:0; white-space:pre-wrap; word-break:break-word; font-family:ui-monospace,Menlo,monospace; font-size:12px; }
  .caught-by { margin-top:10px; font-size:13px; }
  .caught-by .c { color:var(--bad); font-weight:650; }
  details.case { border:1px solid var(--line); border-radius:12px; padding:0 16px; margin-bottom:8px; background:var(--panel); }
  details.case > summary { cursor:pointer; padding:12px 0; font-size:14px; display:flex; justify-content:space-between; gap:10px; list-style:none; }
  details.case > summary::-webkit-details-marker { display:none; }
  details.case[open] > summary { border-bottom:1px solid var(--line); }
  .case-body { padding:12px 0; font-size:13px; }
  .case-body pre { background:color-mix(in srgb,var(--ink) 6%,transparent); border-radius:8px; padding:10px 12px; white-space:pre-wrap; word-break:break-word; font-size:12.5px; margin:6px 0; }
  .ck { display:flex; align-items:center; gap:8px; font-size:13px; margin:3px 0; }
  .dot { width:8px; height:8px; border-radius:50%; flex:none; }
  .dot.ok { background:var(--good); } .dot.no { background:var(--bad); }
  .span-row { font-size:12px; color:var(--muted); font-family:ui-monospace,Menlo,monospace; }
  .k { color:var(--muted); font-size:12px; }
  .trend-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:14px; }
  .trend { border:1px solid var(--line); border-radius:14px; padding:14px 16px; background:var(--panel); }
  .trend .head { display:flex; justify-content:space-between; align-items:baseline; }
  .trend .val { font-size:1.25rem; font-weight:650; letter-spacing:-.02em; }
  .trend .lab { color:var(--muted); font-size:12px; margin:0 0 6px; }
  .trend .dl { font-size:12px; font-weight:650; }
  .trend .dl.up { color:var(--good); } .trend .dl.down { color:var(--bad); } .trend .dl.flat { color:var(--muted); }
  svg.line { width:100%; height:auto; display:block; }
  svg.line .grid { stroke:var(--line); stroke-width:1; }
  svg.line polyline { fill:none; stroke:var(--s1); stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
  svg.line .end { fill:var(--s1); stroke:var(--panel); stroke-width:2; }
  svg.line .slot rect { fill:transparent; }
  svg.line .slot:hover rect { fill:color-mix(in srgb,var(--s1) 10%,transparent); }
  svg.line .slot circle { opacity:0; fill:var(--s1); stroke:var(--panel); stroke-width:2; }
  svg.line .slot:hover circle { opacity:1; }
  .synthetic-note { color:var(--warn); font-size:12px; }
  .loop { display:flex; gap:10px; flex-wrap:wrap; }
  .loop .node { flex:1; min-width:180px; border:1px solid var(--line); border-radius:12px; padding:12px 14px; background:var(--panel); }
  .loop .node b { display:block; font-size:14px; margin-bottom:2px; }
  .loop .node .sub { color:var(--muted); font-size:12px; display:block; margin-bottom:8px; }
  .loop .arrow { align-self:center; color:var(--muted); font-size:20px; }
  svg.waterfall { width:100%; height:auto; max-width:560px; font-size:11px; }
  svg.waterfall .lbl { fill:var(--ink); font-variant-numeric:tabular-nums; }
  svg.waterfall .agent { fill:var(--s1); }
  svg.waterfall .llm { fill:var(--accent); }
  svg.waterfall .tool { fill:var(--good); }
  svg.waterfall .ms { fill:var(--muted); }
  svg.waterfall .bad { fill:var(--bad); }
  .legend { display:flex; gap:14px; font-size:12px; color:var(--muted); margin:4px 0 10px; }
  .legend span::before { content:""; display:inline-block; width:10px; height:10px; border-radius:3px; margin-right:5px; vertical-align:middle; }
  .legend .a::before { background:var(--s1); } .legend .l::before { background:var(--accent); } .legend .t::before { background:var(--good); }
</style>
</head>
<body>
<div class="wrap">
  <header class="hero">
    <h1>{{ title }}</h1>
    <p>Record, replay, score, and gate {{ total_cases }} cases across three suites &middot; generated {{ generated_at }} &middot; $0, zero keys</p>
  </header>

  <div class="grid kpis">
    <div class="tile"><div class="n">{{ recall.caught }}/{{ recall.total }}</div><div class="l">Seeded regressions caught</div></div>
    <div class="tile"><div class="n">{{ determinism.pct }}%</div><div class="l">Replay determinism ({{ determinism.identical }}/{{ determinism.cases }} identical)</div></div>
    <div class="tile"><div class="n">{{ total_cases }}</div><div class="l">Golden cases</div></div>
    <div class="tile"><div class="n">${{ '%.4f'|format(total_cost) }}</div><div class="l">Counterfactual spend</div></div>
    <div class="tile"><div class="n">{{ needs_review }}</div><div class="l">Cases routed to review</div></div>
  </div>

  <section>
    <h2>Monitor &middot; control &middot; optimize</h2>
    <div class="loop">
      <div class="node"><b>Monitor</b><span class="sub">replay &middot; score &middot; profile</span><span class="chip good">{{ loop.determinism_pct }}% deterministic</span></div>
      <div class="arrow">&rarr;</div>
      <div class="node"><b>Control</b><span class="sub">the gate decides</span><span class="chip {{ loop.gate_verdict }}">{{ loop.gate_verdict }}</span> <span class="k">&middot; {{ loop.review_open }} in the review queue</span></div>
      <div class="arrow">&rarr;</div>
      <div class="node"><b>Optimize</b><span class="sub">advise &middot; validate &middot; promote</span><span class="chip SAFE">{{ loop.n_safe }} SAFE</span></div>
    </div>
    <div class="note">Automated: the gate blocks a high-confidence regression. Human-notify: cases routed to review. Hybrid: SAFE optimizations wait for a human to apply.</div>
  </section>

  {% if review %}
  <section>
    <h2>Needs attention &middot; the human-notify tier</h2>
    <p class="note" style="margin:0 0 12px">
      These signals do not block a merge on their own; they wait for a person.
      Resolving a judge-review item with a label feeds the calibration set, so a
      human decision here tightens the gate next time. Clear them with
      <code>tg review resolve &lt;id&gt; --label pass|fail</code>.
    </p>
    <table>
      <thead><tr><th>Signal</th><th>Severity</th><th>Ref</th><th>Why</th></tr></thead>
      <tbody>
        {% for r in review %}
        <tr>
          <td>{{ r.kind }}</td>
          <td><span class="sev {{ r.severity }}">{{ r.severity }}</span></td>
          <td>{{ r.ref }}</td>
          <td>{{ r.reason }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if trends %}
  <section>
    <h2>Performance over time</h2>
    {% for suite, t in trends.items() %}
    <div class="row" style="margin:6px 0 12px">
      <div>
        <strong>{{ suite }}</strong> <span class="k">&middot; {{ t.runs }} runs</span>
        {% if t.spc %}
          {% if t.spc.status == 'drift' %}<span class="chip WARN">drift: {{ t.spc.label }}{% if t.spc.shift_run %} near run {{ t.spc.shift_run }}{% endif %}</span>
          {% else %}<span class="chip good">SPC: recovered excursion{% if t.spc.shift_run %} at run {{ t.spc.shift_run }}{% endif %}</span>{% endif %}
        {% else %}<span class="chip good">SPC: in control</span>{% endif %}
      </div>
      {% if t.synthetic %}<span class="synthetic-note">illustrative history seeded by the demo</span>{% endif %}
    </div>
    <div class="trend-grid">
      {% for c in t.charts %}{% if c.chart %}
      <div class="trend">
        <div class="head">
          <span class="val">{{ '%g'|format(c.latest) }}</span>
          {% if c.delta_good is not none %}<span class="dl {{ 'up' if c.delta_good else 'down' }}">{{ '%+g'|format(c.delta) }}</span>{% else %}<span class="dl flat">no change</span>{% endif %}
        </div>
        <div class="lab">{{ c.label }}</div>
        <svg class="line" viewBox="0 0 {{ c.chart.width }} {{ c.chart.height }}" preserveAspectRatio="none" role="img" aria-label="{{ c.label }} across recent runs">
          {% for g in c.chart.grid %}<line class="grid" x1="0" y1="{{ g.y }}" x2="{{ c.chart.width }}" y2="{{ g.y }}"/>{% endfor %}
          <polyline points="{{ c.chart.points }}"/>
          {% for s in c.chart.slots %}<g class="slot"><rect x="{{ s.x }}" y="0" width="{{ s.w }}" height="{{ c.chart.height }}"><title>{{ s.title }}</title></rect><circle cx="{{ s.cx }}" cy="{{ s.cy }}" r="3"/></g>{% endfor %}
          <circle class="end" cx="{{ c.chart.last.x }}" cy="{{ c.chart.last.y }}" r="4"/>
        </svg>
      </div>
      {% endif %}{% endfor %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if multiagent %}
  <section>
    <h2>Multi-agent trajectory &middot; who did what</h2>
    <p class="note" style="margin:0 0 10px">
      One recorded orchestrator delegating to a retriever and a writer. Cost and
      latency are attributed per agent by walking each span to its nearest agent
      ancestor, so a regression can be traced to the sub-agent that caused it.
    </p>
    {% if multiagent.agents %}
    <table style="max-width:560px">
      <thead><tr><th>Agent</th><th class="num">LLM calls</th><th class="num">Tool calls</th><th class="num">Latency ms</th><th class="num">Cost $</th></tr></thead>
      <tbody>
        {% for a in multiagent.agents %}
        <tr>
          <td class="mono">{{ a.agent }}</td>
          <td class="num">{{ a.llm_calls }}</td>
          <td class="num">{{ a.tool_calls }}</td>
          <td class="num">{{ '%g'|format(a.latency_ms) }}</td>
          <td class="num">{{ '%.6f'|format(a.cost_usd) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
    {% if multiagent.chart %}
    <div class="legend"><span class="a">agent</span><span class="l">llm</span><span class="t">tool</span></div>
    <svg class="waterfall" viewBox="0 0 {{ multiagent.chart.width }} {{ multiagent.chart.height }}" role="img" aria-label="agent trajectory for {{ multiagent.case_id }}">
      {% for r in multiagent.chart.rows %}
      <text class="lbl" x="{{ r.label_x }}" y="{{ r.y + 15 }}">{{ r.kind }}:{{ r.name }}</text>
      <rect class="{{ 'bad' if not r.ok else r.kind }}" x="{{ r.x }}" y="{{ r.bar_y }}" width="{{ r.w }}" height="{{ r.h }}" rx="2"><title>{{ r.kind }}:{{ r.name }} &middot; {{ '%g'|format(r.ms) }}ms</title></rect>
      <text class="ms" x="{{ r.x + r.w + 4 }}" y="{{ r.y + 15 }}">{{ '%g'|format(r.ms) }}ms</text>
      {% endfor %}
    </svg>
    <div class="k">trajectory for case {{ multiagent.case_id }}</div>
    {% endif %}
  </section>
  {% endif %}

  <section>
    <h2>Benchmark vs reference &middot; the gate</h2>
    <div class="card">
      <div class="row">
        <div><strong>Seeded bug:</strong> <span class="mono">{{ gate.bug }}</span> vs the promoted baseline</div>
        <span class="chip {{ gate.verdict }}">{{ gate.verdict }}</span>
      </div>
      <div class="metrics" style="margin-top:16px">
        <div class="m"><div class="v">{{ '%.3f'|format(gate.mean_delta) }}</div><div class="k">mean score &Delta;</div></div>
        <div class="m"><div class="v">[{{ '%.2f'|format(gate.ci[0]) }}, {{ '%.2f'|format(gate.ci[1]) }}]</div><div class="k">95% bootstrap CI</div></div>
        <div class="m"><div class="v">{{ gate.new_invariant_fails }}</div><div class="k">new invariant fails</div></div>
      </div>
      {% if gate.reasons %}<div class="note">Blocked because: {{ gate.reasons | join('; ') }}.</div>{% endif %}
    </div>
  </section>

  {% if gallery %}
  <section>
    <h2>Seeded regressions &middot; the evidence</h2>
    <div class="note" style="margin:-6px 0 14px">Each bug is applied to the baseline agent and replayed from the same fixtures. Here is one concrete example per bug and the exact check that caught it.</div>
    {% for g in gallery %}
    <div class="gallery-item">
      <div class="row">
        <div><strong class="mono">{{ g.id }}</strong> &middot; {{ g.desc }} <span class="k">({{ g.suite }})</span></div>
        <span class="chip {{ 'good' if g.caught else 'bad' }}">{{ 'CAUGHT' if g.caught else 'MISSED' }}</span>
      </div>
      {% if g.example %}
      <div class="k" style="margin-top:8px">case {{ g.example.case_id }}{% if g.example.question %} &middot; "{{ g.example.question }}"{% endif %}</div>
      <div class="diff">
        <div class="col"><h4>baseline output</h4><pre>{{ g.example.baseline_output }}</pre></div>
        <div class="col bad"><h4>buggy output</h4><pre>{{ g.example.buggy_output }}</pre></div>
      </div>
      <div class="caught-by">caught by
        {% for c in g.example.failing_checks %}<span class="c">{{ c.name }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
        &mdash; {{ g.example.failing_checks[0].detail }}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <section>
    <h2>Agent scorecard</h2>
    {% for s in scorecards %}
    <div class="card">
      <div class="row"><strong>{{ s.suite }}</strong><span class="chip good">{{ s.cases }} cases</span></div>
      <div class="metrics">
        <div class="m"><div class="v">{{ s.task_success_pct }}%</div><div class="k">task success</div></div>
        <div class="m"><div class="v">{{ s.mean_score }}</div><div class="k">mean score</div></div>
        <div class="m"><div class="v">{{ s.tool_calls }}</div><div class="k">tool calls</div></div>
        <div class="m"><div class="v">{{ s.invariant_failures }}</div><div class="k">invariant fails</div></div>
        <div class="m"><div class="v">${{ '%.5f'|format(s.cost_usd) }}</div><div class="k">cost</div></div>
      </div>
      <div class="checklist">
        {% for c in s.checks %}
        <div class="checkrow">
          <span class="mono">{{ c.name }}</span>
          <span class="bar"><span style="width:{{ c.pct }}%"></span></span>
          <span class="num">{{ c.pct }}%</span>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </section>

  <section>
    <h2>Efficiency &middot; cost and validated savings</h2>
    <div class="card">
      <div class="metrics">
        <div class="m"><div class="v">${{ '%.6f'|format(profile.totals.cost_usd) }}</div><div class="k">run cost</div></div>
        <div class="m"><div class="v">{{ profile.totals.input_tokens }}</div><div class="k">input tokens</div></div>
        <div class="m"><div class="v">{{ profile.totals.oi_ratio }}</div><div class="k">output/input ratio</div></div>
        <div class="m"><div class="v">{{ profile.latency_ms.p95 }}ms</div><div class="k">p95 latency</div></div>
        <div class="m"><div class="v">{{ profile.budget.pct_used }}%</div><div class="k">of ${{ profile.budget.cap_usd }} budget</div></div>
      </div>
      {% if cost_by_model %}
      <div class="checklist" style="margin-top:8px">
        {% for m in cost_by_model %}
        <div class="checkrow">
          <span class="mono">{{ m.model }}</span>
          <span class="bar"><span style="width:{{ m.pct }}%"></span></span>
          <span class="num">${{ '%.6f'|format(m.cost_usd) }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      <table style="margin-top:18px">
        <thead><tr><th>Recommendation</th><th>Rule</th><th>Status</th><th class="num">Est. saving</th></tr></thead>
        <tbody>
        {% for r in recommendations %}
          <tr>
            <td>{{ r.title }}<div class="note" style="margin:2px 0 0">{{ r.detail }}</div></td>
            <td class="mono">{{ r.rule_id }}</td>
            <td><span class="chip {{ r.status }}">{{ r.status }}</span></td>
            <td class="num">{% if r.est_saving_usd %}${{ '%.6f'|format(r.est_saving_usd) }}{% else %}&mdash;{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      <div class="note">A recommendation is marked SAFE only after a deterministic replay proves it does not regress quality. Judge changes are validated by verdict agreement, not the score gate.</div>
    </div>
  </section>

  <section>
    <h2>Calibration &middot; can the judge be trusted</h2>
    <div class="card">
      <div class="metrics">
        <div class="m"><div class="v">{{ calibration.cohen_kappa }}</div><div class="k">Cohen's &kappa;</div></div>
        <div class="m"><div class="v">{{ calibration.raw_agreement }}</div><div class="k">raw agreement</div></div>
        <div class="m"><div class="v">{{ calibration.pabak }}</div><div class="k">PABAK</div></div>
        <div class="m"><div class="v">{{ calibration.n }}</div><div class="k">labeled pairs</div></div>
        <div class="m"><div class="v"><span class="chip {{ 'good' if calibration.gate_mode == 'judge_gates' else 'INCONCLUSIVE' }}">{{ calibration.gate_mode }}</span></div><div class="k">gate mode</div></div>
      </div>
      {% if calibration.confusion %}
      <div class="confusion" style="margin-top:8px">
        <div class="hd"></div><div class="hd">judge pass</div><div class="hd">judge fail</div>
        <div class="hd">human pass</div><div>{{ calibration.confusion.tp }}</div><div>{{ calibration.confusion.fn }}</div>
        <div class="hd">human fail</div><div>{{ calibration.confusion.fp }}</div><div>{{ calibration.confusion.tn }}</div>
      </div>
      {% endif %}
      <div class="note">This demo calibrates against {{ calibration.n }} deterministic canary golds, an illustrative drift check. A real Cohen's &kappa; requires human labels against a live cross-family judge: run <code>tg label</code> then <code>tg calibrate</code>. The ladder degrades the judge to advisory below &kappa; = 0.55 rather than fake a number.</div>
    </div>
  </section>

  {% if case_details %}
  <section>
    <h2>Case detail &middot; walk every case</h2>
    <div class="note" style="margin:-6px 0 14px">The actual input, the agent's actual output, every check with its detail, the judge, and the trace. Click a case to expand.</div>
    {% for suite, cases in case_details.items() %}
    <h3 style="font-size:14px; margin:18px 0 8px; color:var(--muted)">{{ suite }} ({{ cases|length }})</h3>
    {% for c in cases %}
    <details class="case">
      <summary>
        <span class="mono">{{ c.case_id }}</span>
        <span>
          <span class="k">score {{ c.score }}</span>
          <span class="chip {{ 'good' if c.score >= 1.0 else ('bad' if c.invariant_fail else 'INCONCLUSIVE') }}">{{ c.judge.state or ('PASS' if c.score >= 1.0 else 'CHECK') }}</span>
        </span>
      </summary>
      <div class="case-body">
        <div class="k">question / input</div>
        <div>{{ c.question }}</div>
        <div class="k" style="margin-top:8px">agent output</div>
        <pre>{{ c.output }}</pre>
        <div class="k">checks</div>
        {% for ch in c.checks %}
        <div class="ck"><span class="dot {{ 'ok' if ch.passed else 'no' }}"></span><span class="mono">{{ ch.name }}</span><span class="k">{{ ch.detail }}</span></div>
        {% endfor %}
        {% if c.judge.rationale %}
        <div class="k" style="margin-top:8px">judge</div>
        <div>{{ c.judge.state }} &middot; confidence {{ c.judge.confidence }} &middot; {{ c.judge.rationale }}</div>
        {% endif %}
        <div class="k" style="margin-top:8px">trace</div>
        {% for s in c.spans %}
        <div class="span-row">{{ s.kind }}:{{ s.name }} &middot; {{ s.input_tokens }}+{{ s.output_tokens }} tok &middot; {{ s.latency_ms }}ms &middot; ${{ '%.6f'|format(s.cost_usd) }}</div>
        {% endfor %}
      </div>
    </details>
    {% endfor %}
    {% endfor %}
  </section>
  {% endif %}

  <footer>
    TraceGym &middot; deterministic, keyless agent evaluation. Numbers above are measured from this run, not asserted.
  </footer>
</div>
</body>
</html>
